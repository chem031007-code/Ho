async fn check_lp_lock(rpc: Arc<RpcClient>, mint: Pubkey) -> Result<bool> {
    let largest = rpc.get_token_largest_accounts(&mint)?;

    for acc in largest.value {
        let raw_amount: f64 = acc.amount.parse()?;
        // إذا تجاوزت الحيازة 1000 توكن (رقم تقريبي) قد يكون LP محروقًا
        if raw_amount > 1000.0 {
            return Ok(true);
        }
    }

    Ok(false)
}

// =========================================================
// LIQUIDITY (DexScreener)
// =========================================================
async fn check_liquidity(mint: Pubkey) -> Result<f64> {
    let url = format!(
        "https://api.dexscreener.com/latest/dex/tokens/{}",
        mint
    );

    let response = HttpClient::new().get(url).send().await?;
    let json: Value = response.json().await?;

    let pair = json["pairs"].as_array().and_then(|v| v.first());

    if let Some(pair) = pair {
        return Ok(pair["liquidity"]["usd"].as_f64().unwrap_or(0.0));
    }

    Ok(0.0)
}

