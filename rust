// =========================================================
// CONSTANTS
// =========================================================
const MAX_SAFE_TOP_HOLDER: f64 = 15.0;
const MIN_SAFE_LIQUIDITY: f64 = 5000.0;
const MAX_SAFE_TAX: f64 = 2.0;

// =========================================================
// QUALITY STRUCT
// =========================================================
#[derive(Debug, Clone)]
struct QualityCheck {
    safety_score: u8,
    risk_level: String,
    mint: String,
    dev_wallet: String,
    liquidity_usd: f64,
    top_holder_percent: f64,
    tax_percentage: f64,
    token_2022: bool,
    mint_revoked: bool,
    freeze_revoked: bool,
    metadata_immutable: bool,
    honeypot_risk: bool,
    lp_locked: bool,
    dev_score: i32,
    notes: Vec<String>,
}

// =========================================================
// MAIN
// =========================================================
#[tokio::main]
async fn main() -> Result<()> {
    dotenv().ok();
    tracing_subscriber::fmt()
        .with_env_filter("info")
        .init();

    let rpc_url =
        env::var("RPC_URL").unwrap_or_else(|_| "https://api.mainnet-beta.solana.com".into());
    let ws_url =
        env::var("WS_URL").unwrap_or_else(|_| "wss://api.mainnet-beta.solana.com".into());
    let telegram_token =
        env::var("TELEGRAM_BOT_TOKEN").expect("Missing TELEGRAM_BOT_TOKEN");
    let telegram_chat_id =
        env::var("TELEGRAM_CHAT_ID").expect("Missing TELEGRAM_CHAT_ID");

    let rpc = Arc::new(RpcClient::new(rpc_url));
    let seen_tokens = Arc::new(DashSet::<String>::new());

    info!("🚀 LEGENDARY SNIPER ULTRA PRO STARTED");

    let raydium_program =
        Pubkey::from_str_const("675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8");

    let (_subscription, receiver) = PubsubClient::logs_subscribe(
        &ws_url,
        RpcLogsConfig {
            commitment: Some(CommitmentConfig::processed()),
        },
        RpcLogsFilter::Mentions(vec![raydium_program.to_string()]),
    )?;

    let mut stream = receiver;
    info!("👀 Watching Raydium pools...");

    while let Some(log) = stream.next().await {
        if !log.logs.iter().any(|x| x.contains("initialize2")) {
            continue;
        }

        let tx_sig = match &log.signature {
            Some(v) => v.clone(),
            None => continue,
        };

        warn!("🔥 New pool detected {}", tx_sig);

        let tx = match rpc.get_transaction(
            &Signature::from_str(&tx_sig)?,
            RpcTransactionConfig {
                encoding: Some(UiTransactionEncoding::JsonParsed),
                commitment: None,
                max_supported_transaction_version: Some(0),
            },
        ) {
            Ok(v) => v,
            Err(e) => {
                error!("TX fetch failed {}", e);
                continue;
            }
        };

        let keys = &tx.transaction.message.account_keys;
        if keys.len() <= 8 {
            continue;
        }

        let mint_str = keys[8].to_string();
        if seen_tokens.contains(&mint_str) {
            continue;
        }
        seen_tokens.insert(mint_str.clone());

        let mint = match Pubkey::from_str(&mint_str) {
            Ok(v) => v,
            Err(_) => continue,
        };

        let dev_wallet = keys[0].to_string();
        info!("🪙 New token {}", mint);

        let result = legendary_check(rpc.clone(), mint, dev_wallet.clone()).await;

        match result {
            Ok(quality) => {
                let message = build_telegram_message(&quality);
                send_telegram(&telegram_token, &telegram_chat_id, &message).await;
            }
            Err(e) => {
                error!("Analysis failed {}", e);
            }
        }
    }

    Ok(())
}

// =========================================================
// MAIN ANALYSIS ENGINE
// =========================================================
async fn legendary_check(
    rpc: Arc<RpcClient>,
    mint: Pubkey,
    dev_wallet: String,
) -> Result<QualityCheck> {
    let mut score: i32 = 0;
    let mut notes: Vec<String> = vec![];

    // =====================================================
    // PARALLEL EXECUTION
    // =====================================================
    let (
        metadata_result,
        tax_result,
        holder_result,
        liquidity_result,
        lp_result,
        honeypot_result,
    ) = join!(
        check_metadata_mutable(rpc.clone(), mint),
        check_transfer_tax(rpc.clone(), mint),
        check_holder_distribution(rpc.clone(), mint),
        check_liquidity(mint),
        check_lp_lock(rpc.clone(), mint),
        honeypot_simulation(mint)
    );

    // =====================================================
    // METADATA
    // =====================================================
    let metadata_mutable = metadata_result.unwrap_or(true);
    let metadata_immutable = !metadata_mutable;

    if metadata_immutable {
        score += 10;
        notes.push("✅ Metadata immutable".into());
    } else {
        notes.push("⚠️ Metadata mutable".into());
    }

    // =====================================================
    // TAX
    // =====================================================
    let (tax_percentage, token_2022) = tax_result.unwrap_or((0.0, false));

    if tax_percentage <= MAX_SAFE_TAX {
        score += 10;
        notes.push(format!("✅ Low tax {:.1}%", tax_percentage));
    } else {
        notes.push(format!("⚠️ High tax {:.1}%", tax_percentage));
    }

    // =====================================================
    // AUTHORITIES
    // =====================================================
    let account_data = rpc.get_account_data(&mint)?;
    let mint_state = Mint::unpack(&account_data)?;

    let mint_revoked = mint_state.mint_authority.is_none();
    let freeze_revoked = mint_state.freeze_authority.is_none();

    if mint_revoked {
        score += 20;
        notes.push("✅ Mint revoked".into());
    } else {
        notes.push("⚠️ Mint active".into());
    }

    if freeze_revoked {
        score += 20;
        notes.push("✅ Freeze revoked".into());
    } else {
        notes.push("⚠️ Freeze active".into());
    }

    // =====================================================
    // HOLDER DISTRIBUTION
    // =====================================================
    let top_holder_percent = holder_result.unwrap_or(100.0);

    if top_holder_percent <= MAX_SAFE_TOP_HOLDER {
        score += 5;
        notes.push(format!("✅ Top holder {:.1}%", top_holder_percent));
    } else {
        notes.push(format!("⚠️ Whale concentration {:.1}%", top_holder_percent));
    }

    // =====================================================
    // LIQUIDITY
    // =====================================================
    let liquidity_usd = liquidity_result.unwrap_or(0.0);

    if liquidity_usd >= MIN_SAFE_LIQUIDITY {
        score += 10;
        notes.push(format!("✅ Liquidity ${:.0}", liquidity_usd));
    } else {
        notes.push(format!("⚠️ Low liquidity ${:.0}", liquidity_usd));
    }

    // =====================================================
    // LP LOCK
    // =====================================================
    let lp_locked = lp_result.unwrap_or(false);

    if lp_locked {
        score += 15;
        notes.push("✅ LP likely locked".into());
    } else {
        notes.push("⚠️ LP not verified".into());
    }

    // =====================================================
    // HONEYPOT
    // =====================================================
    let honeypot_risk = honeypot_result.unwrap_or(false);

    if !honeypot_risk {
        score += 10;
        notes.push("✅ No honeypot signals".into());
    } else {
        notes.push("⚠️ Honeypot risk".into());
    }

    // =====================================================
    // DEV REPUTATION
    // =====================================================
    let dev_score = check_dev_wallet_reputation(&dev_wallet).await;
    score += dev_score;

    if dev_score > 0 {
        notes.push("✅ Good dev reputation".into());
    } else {
        notes.push("⚠️ Suspicious dev".into());
    }

    // =====================================================
    // FINALIZE
    // =====================================================
    if score < 0 {
        score = 0;
    }
    if score > 100 {
        score = 100;
    }

    let risk_level = calculate_risk_level(score as u8);

    Ok(QualityCheck {
        safety_score: score as u8,
        risk_level,
        mint: mint.to_string(),
        dev_wallet,
        liquidity_usd,
        top_holder_percent,
        tax_percentage,
        token_2022,
        mint_revoked,
        freeze_revoked,
        metadata_immutable,
        honeypot_risk,
        lp_locked,
        dev_score,
        notes,
    })
}

// =========================================================
// HOLDER ANALYSIS (CORRECTED WITH DECIMALS)
// =========================================================
async fn check_holder_distribution(rpc: Arc<RpcClient>, mint: Pubkey) -> Result<f64> {
    // Fetch mint supply and decimals
    let account_data = rpc.get_account_data(&mint)?;
    let mint_state = Mint::unpack(&account_data)?;
    let decimals = mint_state.decimals;
    let total_supply = mint_state.supply as f64;

    let largest = rpc.get_token_largest_accounts(&mint)?;
    let mut top_amount_raw = 0u128;

    for acc in &largest.value {
        let raw_amount: u128 = acc.amount.parse()?;
        if raw_amount > top_amount_raw {
            top_amount_raw = raw_amount;
        }
    }

    if total_supply == 0.0 {
        return Ok(100.0);
    }

    let top_amount_ui = top_amount_raw as f64 / 10f64.powi(decimals as i32);
    let top_percent = (top_amount_ui / (total_supply / 10f64.powi(decimals as i32))) * 100.0;
    // Alternatively, compute directly from raw amounts:
    // let top_percent = (top_amount_raw as f64 / total_supply) * 100.0;
    // Both are equivalent; using raw is simpler:
    let top_percent = (top_amount_raw as f64 / total_supply) * 100.0;

    Ok(top_percent)
}

// =========================================================
// METADATA CHECK
// =========================================================
async fn check_metadata_mutable(rpc: Arc<RpcClient>, mint: Pubkey) -> Result<bool> {
    let metaplex = Pubkey::from_str_const("metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s");
    let (metadata_pda, _) = Pubkey::find_program_address(
        &[b"metadata", &metaplex.to_bytes(), &mint.to_bytes()],
        &metaplex,
    );

    let data = rpc.get_account_data(&metadata_pda)?;
    if data.len() <= 4 {
        return Ok(true); // Assume mutable if not found
    }
    Ok(data[4] == 1)
}

